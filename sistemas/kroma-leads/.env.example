# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-SECRETA

# --- Segredos do app (invente strings longas e aleatórias) ---
# Protege a rota chamada pelo pg_cron a cada minuto
CRON_SECRET=troque-por-uma-string-aleatoria-longa
# Vai na URL do webhook que o sistema registra na Uazapi
WEBHOOK_SECRET=troque-por-outra-string-aleatoria-longa

# --- Opcional: gerar mensagem única por lead com IA (Claude) ---
# Sem essa chave o recurso fica escondido.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
